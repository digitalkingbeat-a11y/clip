# GEMINI_API_KEY: Required for Gemini AI speech transcription and structured clip moment discovery.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE CREDENTIALS (Authentication & Relational Database):
# When set, ClipFlow syncs user accounts, projects, clips, and jobs with Supabase PostgreSQL and Auth.
# When not set, ClipFlow uses self-contained persistent disk datastore with complete tenant isolation.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible API):
# When set, original uploads, audio, clips, thumbnails, and renders are persisted in Cloudflare R2 with signed URLs.
# When not set, ClipFlow uses local secure S3 storage with HMAC-signed media authorization tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# STRIPE BILLING & SUBSCRIPTIONS:
# Production Stripe API Secret Key (e.g. sk_test_... or sk_live_...) and Webhook Secret (whsec_...).
# When not provided, ClipFlow runs in cryptographically verified sandbox mode for immediate testing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# GOOGLE WORKSPACE & GOOGLE ANALYTICS 4 OAUTH 2.0:
# Configure in Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Enable Google Calendar API, Google Analytics Admin API, and Google Analytics Data API.
# Add Authorized Redirect URI: e.g. https://<your-applet-domain>/api/oauth/google/callback or http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""


# SIGNED FILE LINKS:
# Secret used to sign /storage/... file links (HMAC-SHA256 over path + owner id + expiry).
# Videos, thumbnails, clips and renders are only served with a valid, unexpired signed link,
# so nobody can open another user's file by guessing its name.
# If unset, the server generates one on first start and appends it to .env.local.
# In production (AI Studio / Cloud Run) set it in Secrets so links survive restarts and
# work across instances. Generate one with: openssl rand -hex 32
STORAGE_SIGNING_SECRET=""
# Optional: link lifetime in seconds (default 21600 = 6 hours).
STORAGE_URL_TTL_SECONDS=""
