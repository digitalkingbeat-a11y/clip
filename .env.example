# GEMINI_API_KEY: Required for Gemini AI speech transcription and structured clip moment discovery.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE CREDENTIALS (Authentication & Relational Database):
# When set, ClipFlow syncs user accounts, projects, clips, and jobs with Supabase PostgreSQL and Auth.
# When not set, ClipFlow uses self-contained persistent disk datastore with complete tenant isolation.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible API):
# When set, original uploads, audio, clips, thumbnails, and renders are persisted in Cloudflare R2 with signed URLs.
# When not set, ClipFlow uses local secure S3 storage with HMAC-signed media authorization tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# STRIPE BILLING & SUBSCRIPTIONS:
# Without STRIPE_SECRET_KEY nothing can be bought (checkout shows "Payments aren't set up yet").
# Use a sandbox/test key (sk_test_ or restricted rk_test_) locally and the live key only in production.
# Restricted key permissions needed: Checkout Sessions (write), Customer portal (write),
# Subscriptions (write), Customers (read), Prices/Products (read).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://<your-domain>/api/billing/webhook (Dashboard >
# Developers > Webhooks > endpoint > Signing secret). Required: unsigned events are rejected.
# Endpoint API version must be 2023-10-16 (the version the app pins); events used:
# checkout.session.completed, checkout.session.async_payment_succeeded, invoice.payment_succeeded,
# invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted.
# Local testing: `stripe listen --forward-to localhost:<port>/api/billing/webhook` prints a whsec_ to use here.
STRIPE_WEBHOOK_SECRET=""
# Monthly recurring Price ids per plan (test ids in sandbox, live ids in production).
# Products carry metadata plan_id=<plan>; prices use lookup keys clipflow_<plan>_monthly.
STRIPE_PRICE_BASIC=""             # $10/mo
STRIPE_PRICE_PRO=""               # $15/mo
STRIPE_PRICE_AGENT=""             # $25/mo
STRIPE_PRICE_AGENT_STUDIO=""      # $35/mo
STRIPE_PRICE_AUTOMATED_PIPELINE="" # $100/mo

# GOOGLE WORKSPACE & GOOGLE ANALYTICS 4 OAUTH 2.0:
# Configure in Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Enable Google Calendar API, Google Analytics Admin API, and Google Analytics Data API.
# Add Authorized Redirect URI: e.g. https://<your-applet-domain>/api/oauth/google/callback or http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""


# SIGNED FILE LINKS:
# Secret used to sign /storage/... file links (HMAC-SHA256 over path + owner id + expiry).
# Videos, thumbnails, clips and renders are only served with a valid, unexpired signed link,
# so nobody can open another user's file by guessing its name.
# If unset, the server generates one on first start and appends it to .env.local.
# In production (AI Studio / Cloud Run) set it in Secrets so links survive restarts and
# work across instances. Generate one with: openssl rand -hex 32
STORAGE_SIGNING_SECRET=""
# Optional: link lifetime in seconds (default 21600 = 6 hours).
STORAGE_URL_TTL_SECONDS=""

# FREE STOCK FOOTAGE (AI Video "Stock footage" mode, 0 credits). Set either key, or both.
# Pixabay is used first when its key is set; Pexels is used next. With neither, scenes use Quick preview cards.
# Pixabay: free key at https://pixabay.com/api/docs/ (searches are cached 24h, kept under 100 requests/min,
# clips are downloaded to storage and credited "Video from Pixabay by {user}").
PIXABAY_API_KEY=""
# Legacy AI Studio secret name is also supported: PixabayAPI
# Pexels: https://www.pexels.com/api/ (credited "Videos provided by Pexels").
PEXELS_API_KEY=""

# RUNNINGHUB AI VIDEO (optional, paid): https://www.runninghub.ai/runninghub-api-doc-en/
# Without RUNNINGHUB_API_KEY the AI Video page shows RunningHub as "Not set up".
# Key types: an Enterprise-Shared key (pay-as-you-go wallet) can call the Standard Model APIs,
# so with just the key RunningHub uses Seedance 2.0 Fast (listed at $0.08 per second, 4-15s, 720p).
# A Consumer-Member (membership) key can only run Workflows / AI Apps: set the workflow or app id
# plus the node mapping ("nodeId:fieldName" from the workflow's API view) and RUNNINGHUB_MODEL_API=false.
RUNNINGHUB_API_KEY=""
# RUNNINGHUB_BASE_URL="https://www.runninghub.ai"   # or https://www.runninghub.cn
# RUNNINGHUB_MODEL_API="true"                        # false = never use the Standard Model API
# RUNNINGHUB_T2V_MODEL_ENDPOINT="rhart-video/sparkvideo-2.0-fast/text-to-video"
# RUNNINGHUB_I2V_MODEL_ENDPOINT="rhart-video/sparkvideo-2.0-fast/image-to-video"
# RUNNINGHUB_RESOLUTION="720p"
# Workflow / AI App mode (takes priority over the model endpoint when set):
# RUNNINGHUB_T2V_WORKFLOW_ID=""   or   RUNNINGHUB_T2V_APP_ID=""
# RUNNINGHUB_T2V_PROMPT_NODE=""   e.g. "6:text"
# RUNNINGHUB_T2V_DURATION_NODE="" optional, e.g. "12:seconds"
# RUNNINGHUB_T2V_EXTRA_NODES=""   optional JSON array of {nodeId, fieldName, fieldValue}
# RUNNINGHUB_I2V_WORKFLOW_ID=""   or   RUNNINGHUB_I2V_APP_ID=""
# RUNNINGHUB_I2V_PROMPT_NODE="" / RUNNINGHUB_I2V_IMAGE_NODE="" (LoadImage node, e.g. "10:image")
# RUNNINGHUB_I2V_DURATION_NODE="" / RUNNINGHUB_I2V_EXTRA_NODES=""
# RUNNINGHUB_INSTANCE_TYPE=""     workflow/app only: default | plus | ultra
# Credits charged to the user (refunded on failure / timeout):
# RUNNINGHUB_CREDITS_PER_SECOND="2"   (Veo Lite is 1 credit/s at $0.05/s; Seedance 2.0 Fast is $0.08/s)
# RUNNINGHUB_CREDITS_PER_JOB=""       flat price per clip; overrides per-second when set
# RUNNINGHUB_PRICE_USD_PER_SECOND="0.08"  cost estimate recorded with each usage event
# RUNNINGHUB_TIMEOUT_MS="1200000"     max 28 min (credit holds last 30 min)
# RUNNINGHUB_POLL_INTERVAL_MS="8000"
# RUNNINGHUB_MAX_DOWNLOAD_MB="500"
